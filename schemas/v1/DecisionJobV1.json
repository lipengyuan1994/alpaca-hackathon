{
  "$defs": {
    "AccountSnapshotV1": {
      "additionalProperties": false,
      "properties": {
        "account_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Account Id",
          "type": "string"
        },
        "as_of": {
          "format": "date-time",
          "title": "As Of",
          "type": "string"
        },
        "buying_power": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Buying Power"
        },
        "cash": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Cash"
        },
        "content_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Hash"
        },
        "day_start_equity": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Day Start Equity"
        },
        "equity": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Equity"
        },
        "schema_version": {
          "const": "account-snapshot/v1",
          "default": "account-snapshot/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "snapshot_id": {
          "minLength": 1,
          "title": "Snapshot Id",
          "type": "string"
        },
        "version": {
          "minimum": 0,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "snapshot_id",
        "account_id",
        "version",
        "as_of",
        "equity",
        "cash",
        "buying_power"
      ],
      "title": "AccountSnapshotV1",
      "type": "object"
    },
    "ControlStateV1": {
      "additionalProperties": false,
      "properties": {
        "account_allowlist_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Account Allowlist Hash",
          "type": "string"
        },
        "account_id": {
          "title": "Account Id",
          "type": "string"
        },
        "config_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Config Hash",
          "type": "string"
        },
        "content_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Hash"
        },
        "mode": {
          "$ref": "#/$defs/OperatingModeV1",
          "default": "DISARMED"
        },
        "reconciled_at": {
          "format": "date-time",
          "title": "Reconciled At",
          "type": "string"
        },
        "reconciliation_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Reconciliation Hash",
          "type": "string"
        },
        "release_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Release Hash",
          "type": "string"
        },
        "schema_version": {
          "const": "control-state/v1",
          "default": "control-state/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "version": {
          "minimum": 0,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "account_id",
        "version",
        "release_hash",
        "config_hash",
        "account_allowlist_hash",
        "reconciliation_hash",
        "reconciled_at"
      ],
      "title": "ControlStateV1",
      "type": "object"
    },
    "FeatureVectorV1": {
      "additionalProperties": false,
      "properties": {
        "available_time": {
          "format": "date-time",
          "title": "Available Time",
          "type": "string"
        },
        "calculated_at": {
          "format": "date-time",
          "title": "Calculated At",
          "type": "string"
        },
        "content_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Hash"
        },
        "feature_contract_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Feature Contract Hash",
          "type": "string"
        },
        "feature_id": {
          "minLength": 1,
          "title": "Feature Id",
          "type": "string"
        },
        "schema_version": {
          "const": "feature-vector/v1",
          "default": "feature-vector/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_market_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Source Market Hash",
          "type": "string"
        },
        "values": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              }
            ]
          },
          "title": "Values",
          "type": "object"
        }
      },
      "required": [
        "feature_id",
        "feature_contract_hash",
        "calculated_at",
        "available_time",
        "values",
        "source_market_hash"
      ],
      "title": "FeatureVectorV1",
      "type": "object"
    },
    "FeedIdentityV1": {
      "additionalProperties": false,
      "properties": {
        "entitlement": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Entitlement",
          "type": "string"
        },
        "equity": {
          "const": "iex",
          "default": "iex",
          "title": "Equity",
          "type": "string"
        },
        "options": {
          "const": "indicative",
          "default": "indicative",
          "title": "Options",
          "type": "string"
        }
      },
      "required": [
        "entitlement"
      ],
      "title": "FeedIdentityV1",
      "type": "object"
    },
    "MarketClockV1": {
      "additionalProperties": false,
      "description": "Broker-observed market clock; local wall-clock guesses are not authority.",
      "properties": {
        "as_of": {
          "format": "date-time",
          "title": "As Of",
          "type": "string"
        },
        "is_open": {
          "title": "Is Open",
          "type": "boolean"
        },
        "next_close": {
          "format": "date-time",
          "title": "Next Close",
          "type": "string"
        },
        "next_open": {
          "format": "date-time",
          "title": "Next Open",
          "type": "string"
        }
      },
      "required": [
        "is_open",
        "as_of",
        "next_open",
        "next_close"
      ],
      "title": "MarketClockV1",
      "type": "object"
    },
    "MarketSnapshotV1": {
      "additionalProperties": false,
      "properties": {
        "as_of": {
          "format": "date-time",
          "title": "As Of",
          "type": "string"
        },
        "clock": {
          "anyOf": [
            {
              "$ref": "#/$defs/MarketClockV1"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "content_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Hash"
        },
        "feed_identity": {
          "$ref": "#/$defs/FeedIdentityV1"
        },
        "option_contracts": {
          "default": [],
          "items": {
            "$ref": "#/$defs/OptionContractV1"
          },
          "title": "Option Contracts",
          "type": "array"
        },
        "quality_flags": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Quality Flags",
          "type": "array"
        },
        "schema_version": {
          "const": "market-snapshot/v1",
          "default": "market-snapshot/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "snapshot_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Snapshot Id",
          "type": "string"
        },
        "underlying_quotes": {
          "additionalProperties": {
            "$ref": "#/$defs/QuoteV1"
          },
          "minProperties": 1,
          "title": "Underlying Quotes",
          "type": "object"
        }
      },
      "required": [
        "snapshot_id",
        "as_of",
        "feed_identity",
        "underlying_quotes"
      ],
      "title": "MarketSnapshotV1",
      "type": "object"
    },
    "OperatingModeV1": {
      "enum": [
        "DISARMED",
        "REPLAY",
        "SHADOW",
        "PAPER_DEMO_ARMED",
        "PAPER_ARMED",
        "FLATTENING",
        "HALTED"
      ],
      "title": "OperatingModeV1",
      "type": "string"
    },
    "OptionContractV1": {
      "additionalProperties": false,
      "properties": {
        "deliverable": {
          "const": "STANDARD",
          "default": "STANDARD",
          "title": "Deliverable",
          "type": "string"
        },
        "expiration": {
          "format": "date-time",
          "title": "Expiration",
          "type": "string"
        },
        "multiplier": {
          "const": 100,
          "default": 100,
          "title": "Multiplier",
          "type": "integer"
        },
        "quote": {
          "$ref": "#/$defs/QuoteV1"
        },
        "right": {
          "enum": [
            "CALL",
            "PUT"
          ],
          "title": "Right",
          "type": "string"
        },
        "strike": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Strike"
        },
        "symbol": {
          "pattern": "^[A-Z0-9]{1,32}$",
          "title": "Symbol",
          "type": "string"
        },
        "underlying": {
          "pattern": "^[A-Z]{1,8}$",
          "title": "Underlying",
          "type": "string"
        }
      },
      "required": [
        "symbol",
        "underlying",
        "right",
        "strike",
        "expiration",
        "quote"
      ],
      "title": "OptionContractV1",
      "type": "object"
    },
    "OrderRiskSnapshotV1": {
      "additionalProperties": false,
      "properties": {
        "account_id": {
          "minLength": 1,
          "title": "Account Id",
          "type": "string"
        },
        "as_of": {
          "format": "date-time",
          "title": "As Of",
          "type": "string"
        },
        "content_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Hash"
        },
        "reservations": {
          "default": [],
          "items": {
            "$ref": "#/$defs/RiskReservationV1"
          },
          "title": "Reservations",
          "type": "array"
        },
        "schema_version": {
          "const": "order-risk-snapshot/v1",
          "default": "order-risk-snapshot/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "snapshot_id": {
          "minLength": 1,
          "title": "Snapshot Id",
          "type": "string"
        },
        "version": {
          "minimum": 0,
          "title": "Version",
          "type": "integer"
        },
        "working_client_order_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Working Client Order Ids",
          "type": "array"
        }
      },
      "required": [
        "snapshot_id",
        "account_id",
        "version",
        "as_of"
      ],
      "title": "OrderRiskSnapshotV1",
      "type": "object"
    },
    "PositionLegV1": {
      "additionalProperties": false,
      "properties": {
        "quantity": {
          "title": "Quantity",
          "type": "integer"
        },
        "symbol": {
          "pattern": "^[A-Z0-9]{1,32}$",
          "title": "Symbol",
          "type": "string"
        }
      },
      "required": [
        "symbol",
        "quantity"
      ],
      "title": "PositionLegV1",
      "type": "object"
    },
    "PositionSnapshotV1": {
      "additionalProperties": false,
      "properties": {
        "account_id": {
          "minLength": 1,
          "title": "Account Id",
          "type": "string"
        },
        "as_of": {
          "format": "date-time",
          "title": "As Of",
          "type": "string"
        },
        "content_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Hash"
        },
        "legs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PositionLegV1"
          },
          "title": "Legs",
          "type": "array"
        },
        "schema_version": {
          "const": "position-snapshot/v1",
          "default": "position-snapshot/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "snapshot_id": {
          "minLength": 1,
          "title": "Snapshot Id",
          "type": "string"
        },
        "version": {
          "minimum": 0,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "snapshot_id",
        "account_id",
        "version",
        "as_of"
      ],
      "title": "PositionSnapshotV1",
      "type": "object"
    },
    "QuoteV1": {
      "additionalProperties": false,
      "properties": {
        "ask": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Ask"
        },
        "available_time": {
          "format": "date-time",
          "title": "Available Time",
          "type": "string"
        },
        "bid": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Bid"
        },
        "event_time": {
          "format": "date-time",
          "title": "Event Time",
          "type": "string"
        }
      },
      "required": [
        "bid",
        "ask",
        "event_time",
        "available_time"
      ],
      "title": "QuoteV1",
      "type": "object"
    },
    "RiskReservationV1": {
      "additionalProperties": false,
      "properties": {
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "maximum_loss": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Maximum Loss"
        },
        "plan_hash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Plan Hash",
          "type": "string"
        },
        "remaining_quantity": {
          "exclusiveMinimum": 0,
          "title": "Remaining Quantity",
          "type": "integer"
        },
        "reservation_id": {
          "minLength": 1,
          "title": "Reservation Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "APPROVED",
            "ACCEPTED",
            "PARTIAL",
            "UNKNOWN"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "reservation_id",
        "plan_hash",
        "maximum_loss",
        "remaining_quantity",
        "expires_at",
        "status"
      ],
      "title": "RiskReservationV1",
      "type": "object"
    },
    "StrategyConfigV1": {
      "additionalProperties": false,
      "properties": {
        "config_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Config Hash"
        },
        "schema_version": {
          "const": "strategy-config/v1",
          "default": "strategy-config/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "values": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              },
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "title": "Values",
          "type": "object"
        }
      },
      "required": [
        "values"
      ],
      "title": "StrategyConfigV1",
      "type": "object"
    },
    "StrategyStateV1": {
      "additionalProperties": false,
      "properties": {
        "as_of": {
          "format": "date-time",
          "title": "As Of",
          "type": "string"
        },
        "payload": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Payload",
          "type": "object"
        },
        "plugin_id": {
          "title": "Plugin Id",
          "type": "string"
        },
        "plugin_version": {
          "title": "Plugin Version",
          "type": "string"
        },
        "sequence": {
          "minimum": 0,
          "title": "Sequence",
          "type": "integer"
        },
        "state_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "State Hash"
        },
        "state_schema_version": {
          "const": "strategy-state/v1",
          "default": "strategy-state/v1",
          "title": "State Schema Version",
          "type": "string"
        }
      },
      "required": [
        "plugin_id",
        "plugin_version",
        "as_of",
        "sequence"
      ],
      "title": "StrategyStateV1",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Credential-free, sanitized input consumed by the durable decision worker.",
  "properties": {
    "account": {
      "$ref": "#/$defs/AccountSnapshotV1"
    },
    "as_of": {
      "format": "date-time",
      "title": "As Of",
      "type": "string"
    },
    "config": {
      "$ref": "#/$defs/StrategyConfigV1"
    },
    "control_state": {
      "$ref": "#/$defs/ControlStateV1"
    },
    "entry_cutoff_at": {
      "format": "date-time",
      "title": "Entry Cutoff At",
      "type": "string"
    },
    "feature_vector": {
      "$ref": "#/$defs/FeatureVectorV1"
    },
    "flatten_at": {
      "format": "date-time",
      "title": "Flatten At",
      "type": "string"
    },
    "job_hash": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Job Hash"
    },
    "job_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Job Id",
      "type": "string"
    },
    "market": {
      "$ref": "#/$defs/MarketSnapshotV1"
    },
    "order_risk": {
      "$ref": "#/$defs/OrderRiskSnapshotV1"
    },
    "plugin_id": {
      "pattern": "^[a-z][a-z0-9_]{1,63}$",
      "title": "Plugin Id",
      "type": "string"
    },
    "plugin_version": {
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "title": "Plugin Version",
      "type": "string"
    },
    "positions": {
      "$ref": "#/$defs/PositionSnapshotV1"
    },
    "prior_state": {
      "$ref": "#/$defs/StrategyStateV1"
    },
    "run_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "decision-job/v1",
      "default": "decision-job/v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "job_id",
    "run_id",
    "as_of",
    "plugin_id",
    "plugin_version",
    "market",
    "feature_vector",
    "account",
    "positions",
    "order_risk",
    "control_state",
    "prior_state",
    "config",
    "entry_cutoff_at",
    "flatten_at"
  ],
  "title": "DecisionJobV1",
  "type": "object"
}
