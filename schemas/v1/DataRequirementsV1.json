      "title": "Maximum Observation Age Seconds",
      "type": "integer"
    },
    "needs_logical_positions": {
      "default": false,
      "title": "Needs Logical Positions",
      "type": "boolean"
    },
    "required_feature_keys": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Required Feature Keys",
      "type": "array"
    },
    "underlyings": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Underlyings",
      "type": "array"
    }
