# syntax=docker/dockerfile:1
# The public API image contains no decision, execution, agent, or broker package.
FROM python:3.12-slim AS api
ARG TARGETARCH
RUN test "$TARGETARCH" = "arm64" || test "$TARGETARCH" = "amd64"
WORKDIR /app
COPY packages/contracts packages/contracts
COPY packages/ledger packages/ledger
COPY apps/api apps/api
RUN pip install --no-cache-dir "fastapi==0.141.1" "uvicorn==0.41.0" "pydantic==2.13.5"
CMD ["uvicorn", "apps.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
