{
  "additionalProperties": false,
  "properties": {
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "maximum_loss": {
      "anyOf": [
        {
          "exclusiveMinimum": 0.0,
          "type": "number"
        },
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        }
      ],
      "title": "Maximum Loss"
    },
    "plan_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Plan Hash",
      "type": "string"
    },
    "remaining_quantity": {
      "exclusiveMinimum": 0,
      "title": "Remaining Quantity",
      "type": "integer"
    },
    "reservation_id": {
      "minLength": 1,
      "title": "Reservation Id",
      "type": "string"
    },
    "status": {
      "enum": [
        "APPROVED",
        "ACCEPTED",
        "PARTIAL",
        "UNKNOWN"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "reservation_id",
    "plan_hash",
    "maximum_loss",
    "remaining_quantity",
    "expires_at",
    "status"
  ],
  "title": "RiskReservationV1",
  "type": "object"
}
