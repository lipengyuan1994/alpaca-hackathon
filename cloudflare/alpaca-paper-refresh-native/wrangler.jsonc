{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "alpaca-paper-refresh-native",
  "main": "alarm-entry.js",
  "compatibility_date": "2026-09-03",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1,
      "persist": true
    }
  },
  "durable_objects": {
    "bindings": [{ "name": "PAPER_REFRESH_SCHEDULER", "class_name": "PaperRefreshScheduler" }]
  },
  "migrations": [{ "tag": "v1-alarm-scheduler", "new_sqlite_classes": ["PaperRefreshScheduler"] }],
  "triggers": { "crons": [] }
}
