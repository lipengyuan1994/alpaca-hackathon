#!/bin/sh
set -eu

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

python_path="$repo_root/.venv/bin/python"
if [ ! -x "$python_path" ]; then
  echo "pre-commit: create the repository's native Python environment first" >&2
  exit 1
fi

exec "$python_path" scripts/refresh_public_paper_snapshot.py --stage
