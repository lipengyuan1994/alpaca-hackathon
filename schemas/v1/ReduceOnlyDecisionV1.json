{
  "additionalProperties": false,
  "properties": {
    "allowed": {
      "title": "Allowed",
      "type": "boolean"
    },
    "control_state_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Control State Hash",
      "type": "string"
    },
    "decision_hash": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Decision Hash"
    },
    "decision_id": {
      "minLength": 1,
      "title": "Decision Id",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "managed_position_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Managed Position Hash",
      "type": "string"
    },
    "plan_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Plan Hash",
      "type": "string"
    },
    "position_snapshot_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Position Snapshot Hash",
      "type": "string"
    },
    "reason_codes": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Reason Codes",
      "type": "array"
    },
    "schema_version": {
      "const": "reduce-only-decision/v1",
      "default": "reduce-only-decision/v1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "decision_id",
    "plan_hash",
    "position_snapshot_hash",
    "managed_position_hash",
    "control_state_hash",
    "allowed",
    "reason_codes",
    "expires_at"
